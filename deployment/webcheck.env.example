# Example only. Use your hosting service's secret/environment settings.
# Do not put real credentials in this file, GitHub Pages, or a committed .env.
WEBCHECK_PROVIDER=tavily
TAVILY_API_KEY=
# Select WEBCHECK_PROVIDER=brave to use this instead:
BRAVE_SEARCH_API_KEY=

# Remote binding requires all three values. Token must contain at least 32 chars.
# Generate a service token: python webcheck_server.py --generate-access-token
# This service token is for trusted users, never a provider API key.
WEBCHECK_ACCESS_TOKEN=
WEBCHECK_ALLOWED_HOSTS=check.example.com
WEBCHECK_ALLOWED_ORIGINS=https://potervlag-cyber.github.io

# Global reserved search queries per rolling hour, across all visitors.
# Failed requests remain reserved to prevent retry-driven API overspending.
WEBCHECK_HOURLY_QUERY_BUDGET=100

# Optional model review; independent of the search API key. Keep all on server.
# BASE_URL is a public HTTPS API base, e.g. https://api.openai.com/v1
# Empty/missing fields leave search working and review explicitly not_configured.
CONTENT_REVIEW_API_KEY=
CONTENT_REVIEW_BASE_URL=
CONTENT_REVIEW_MODEL=
# Global rolling-hour model POST budget. Failed requests remain reserved.
CONTENT_REVIEW_HOURLY_BUDGET=20
